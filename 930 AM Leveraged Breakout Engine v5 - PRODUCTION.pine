//@version=6
indicator("930 AM Leveraged Breakout Engine v5 - PRODUCTION", overlay=true)

// --- Inputs ---
atrPeriod     = input.int(14, title="ATR Period for Volatility Tracking")
atrMultiplier = input.float(1.5, title="ATR Trailing Multiplier")

// --- Structural Time Filters (Exchange Timezone) ---
is_session_start = not na(time(timeframe.period, "0930-0935:23456", "America/New_York"))
inTradeWindow    = not na(time(timeframe.period, "0935-1550:23456", "America/New_York"))
isMarketClose    = not na(time(timeframe.period, "1555-1600:23456", "America/New_York"))
isNewDay         = ta.change(time("D", "America/New_York")) != 0

// --- Persistent Range Variables ---
var float openHigh = na
var float openLow  = na
var bool rangeCaptured = false

// Reset memory registers cleanly at the exact first candle of the trading day
if (isNewDay)
    openHigh := na
    openLow  := na
    rangeCaptured := false

// Continuously track and widen the range boundaries during the 9:30-9:35 AM window
if (is_session_start)
    if (not rangeCaptured or na(openHigh))
        openHigh := high
        openLow  := low
        rangeCaptured := true
    else
        openHigh := math.max(high, openHigh)
        openLow  := math.min(low, openLow)

// --- Volatility Calculations ---
atr = ta.atr(atrPeriod)

// --- Visual Layout Elements ---
plot(inTradeWindow ? openHigh : na, color=color.green, style=plot.style_linebr, linewidth=2, title="Long Breakout Line")
plot(inTradeWindow ? openLow : na, color=color.red, style=plot.style_linebr, linewidth=2, title="Short Breakout Line")

// --- Position State Tracking ---
var int position_state = 0 // 0 = Flat, 1 = Long, -1 = Short
var float stopLossPrice = na

// Fixed Conditions: Must evaluate breakout against a confirmed closed candle inside the allowed window
longCondition  = ta.crossover(close, openHigh) and inTradeWindow and position_state == 0 and not na(openHigh)
shortCondition = ta.crossunder(close, openLow) and inTradeWindow and position_state == 0 and not na(openLow)

// --- Trade Signals & JSON Webhook Structuring ---
if (longCondition)
    position_state := 1
    stopLossPrice := close - (atr * atrMultiplier)
    alert('{"symbol": "' + syminfo.ticker + '", "side": "buy", "atr": ' + str.tostring(atr * atrMultiplier) + '}', alert.freq_once_per_bar)

if (shortCondition)
    position_state := -1
    stopLossPrice := close + (atr * atrMultiplier)
    alert('{"symbol": "' + syminfo.ticker + '", "side": "sell", "atr": ' + str.tostring(atr * atrMultiplier) + '}', alert.freq_once_per_bar)

// --- Active Position Trailing Logic ---
if (position_state == 1)
    stopLossPrice := math.max(stopLossPrice, high - (atr * atrMultiplier))
    if (close <= stopLossPrice)
        position_state := 0
        alert('{"symbol": "' + syminfo.ticker + '", "side": "exit", "reason": "Trailing Stop Hit"}', alert.freq_once_per_bar)

if (position_state == -1)
    stopLossPrice := math.min(stopLossPrice, low + (atr * atrMultiplier))
    if (close >= stopLossPrice)
        position_state := 0
        alert('{"symbol": "' + syminfo.ticker + '", "side": "exit", "reason": "Trailing Stop Hit"}', alert.freq_once_per_bar)

// --- End of Day Safety Liquidation ---
if (isMarketClose and position_state != 0)
    position_state := 0
    alert('{"symbol": "' + syminfo.ticker + '", "side": "exit", "reason": "EOD Liquidation"}', alert.freq_once_per_bar)
