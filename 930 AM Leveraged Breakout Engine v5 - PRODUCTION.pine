//@version=6
indicator("930 AM Leveraged Breakout Engine v8 - PRODUCTION", overlay=true)

// --- Inputs ---
webhookSecret    = input.string("", title="Webhook Secret (must match WEBHOOK_SECRET env var on server)")
atrPeriod        = input.int(14, title="ATR Period for Volatility Tracking")
bufferMultiplier = input.float(0.1, title="False Breakout ATR Buffer (e.g. 0.1 = 10% of ATR)", minval=0.0)

trendEmaFast     = input.int(5, title="Trend Filter Fast EMA Period")
trendEmaSlow     = input.int(20, title="Trend Filter Slow EMA Period")
volMovingAvg     = input.int(20, title="Volume Moving Average Period")
minVolRatio      = input.float(0.65, title="Minimum Volume Ratio for Breakout")
cooldownBars     = input.int(3, title="Bars Cooldown Between Trades")

// --- Structural Time Filters (Exchange Timezone) ---
// Shrink-by-1-min approach: each window ends 1 bar before the next begins.
// This avoids overlap on 5-min charts where "extend" would put the 9:35 bar
// inside both is_session_start and inTradeWindow simultaneously.
is_session_start  = not na(time(timeframe.period, "0930-0934:23456", "America/New_York"))
inTradeWindow     = not na(time(timeframe.period, "0935-1100:23456", "America/New_York"))
isMiddayWindow    = not na(time(timeframe.period, "1100-1229:23456", "America/New_York"))
isAfternoonWindow = not na(time(timeframe.period, "1230-1550:23456", "America/New_York"))
isMarketClose     = not na(time(timeframe.period, "1555-1600:23456", "America/New_York"))
isNewDay          = ta.change(time("D", "America/New_York")) != 0

// --- Persistent Range & State Variables ---
var float openHigh      = na
var float openLow       = na
var float middayHigh    = na
var float middayLow     = na
var int   barsSinceEntry = cooldownBars + 1
var bool  eodAlertSent  = false   // FIX 3: prevents EOD webhook spam across multiple bars/ticks

if isNewDay
    openHigh       := na
    openLow        := na
    middayHigh     := na
    middayLow      := na
    barsSinceEntry := cooldownBars + 1
    eodAlertSent   := false        // FIX 3: reset EOD flag each new trading day

// Capture 9:30–9:35 opening range
if is_session_start
    if na(openHigh)
        openHigh := high
        openLow  := low
    else
        openHigh := math.max(openHigh, high)
        openLow  := math.min(openLow, low)

// Capture 11:00–12:30 midday consolidation range
if isMiddayWindow
    if na(middayHigh)
        middayHigh := high
        middayLow  := low
    else
        middayHigh := math.max(middayHigh, high)
        middayLow  := math.min(middayLow, low)

// --- Volatility, Volume, and Buffer Calculations ---
atr            = ta.atr(atrPeriod)
breakoutBuffer = atr * bufferMultiplier

volMa          = ta.sma(volume, volMovingAvg)
volRatio       = not na(volMa) and volMa > 0 ? volume / volMa : 0.0
volSufficient  = volRatio >= minVolRatio

// --- Trend Filter Calculations ---
emaFast        = ta.ema(close, trendEmaFast)
emaSlow        = ta.ema(close, trendEmaSlow)
trendBullish   = emaFast > emaSlow
trendBearish   = emaFast < emaSlow

// --- Cooldown Counter (increments every bar, resets on entry) ---
// FIX 2 (already resolved): increment runs every bar so cooldown is a true rolling window
barsSinceEntry := barsSinceEntry + 1
cooldownClear  = barsSinceEntry > cooldownBars

// --- FIX 4: Deterministic bar-close timestamp instead of live wall-clock timenow ---
// time_close is the immutable exchange timestamp of when this bar ended.
// timenow was the physical machine clock at the moment the script ran — non-reproducible in history.
alert_ts = str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", "UTC")

// --- FIX 1: barstate.isconfirmed gates all signals to closed bars only ---
// crossover/crossunder can trigger on any intrabar tick mid-candle.
// Without this guard, a price spike that retreats before bar close sends a live Alpaca
// order for a signal that will vanish from the chart when the bar finalises.
// barstate.isconfirmed is true only on the final (closing) tick of each bar.

// --- Morning Opening Range Breakout (9:35 AM – 11:00 AM) ---
longCondition  = ta.crossover(close, openHigh + breakoutBuffer)  and inTradeWindow     and cooldownClear and not na(openHigh)   and volSufficient and trendBullish and barstate.isconfirmed
shortCondition = ta.crossunder(close, openLow  - breakoutBuffer) and inTradeWindow     and cooldownClear and not na(openLow)    and volSufficient and trendBearish and barstate.isconfirmed

// --- Afternoon Midday Consolidation Breakout (12:30 PM – 3:50 PM) ---
afternoonLong  = ta.crossover(close, middayHigh + breakoutBuffer) and isAfternoonWindow and cooldownClear and not na(middayHigh) and volSufficient and trendBullish and barstate.isconfirmed
afternoonShort = ta.crossunder(close, middayLow  - breakoutBuffer) and isAfternoonWindow and cooldownClear and not na(middayLow)  and volSufficient and trendBearish and barstate.isconfirmed

// --- Alert & Webhook Generation (Entry Only — Alpaca Owns All Exits) ---
if longCondition
    barsSinceEntry := 0
    alert('{"symbol": "' + syminfo.ticker + '", "side": "buy", "price": ' + str.tostring(close) + ', "atr": ' + str.tostring(atr) + ', "vol_ratio": ' + str.tostring(volRatio, "#.##") + ', "alert_time": "' + alert_ts + '", "secret": "' + webhookSecret + '"}', alert.freq_once_per_bar)

if shortCondition
    barsSinceEntry := 0
    alert('{"symbol": "' + syminfo.ticker + '", "side": "sell", "price": ' + str.tostring(close) + ', "atr": ' + str.tostring(atr) + ', "vol_ratio": ' + str.tostring(volRatio, "#.##") + ', "alert_time": "' + alert_ts + '", "secret": "' + webhookSecret + '"}', alert.freq_once_per_bar)

if afternoonLong
    barsSinceEntry := 0
    alert('{"symbol": "' + syminfo.ticker + '", "side": "buy", "price": ' + str.tostring(close) + ', "atr": ' + str.tostring(atr) + ', "vol_ratio": ' + str.tostring(volRatio, "#.##") + ', "alert_time": "' + alert_ts + '", "secret": "' + webhookSecret + '"}', alert.freq_once_per_bar)

if afternoonShort
    barsSinceEntry := 0
    alert('{"symbol": "' + syminfo.ticker + '", "side": "sell", "price": ' + str.tostring(close) + ', "atr": ' + str.tostring(atr) + ', "vol_ratio": ' + str.tostring(volRatio, "#.##") + ', "alert_time": "' + alert_ts + '", "secret": "' + webhookSecret + '"}', alert.freq_once_per_bar)

// --- End of Day Safety Liquidation ---
// FIX 3: eodAlertSent flag ensures exactly one EOD webhook fires per day.
// Without it, every bar (and every tick on live data) inside the 1555-1600 window
// fires a separate exit payload, causing duplicate liquidation attempts on the server.
if isMarketClose and not eodAlertSent and barstate.isconfirmed
    eodAlertSent := true
    alert('{"symbol": "' + syminfo.ticker + '", "side": "exit", "reason": "EOD Liquidation", "alert_time": "' + alert_ts + '", "secret": "' + webhookSecret + '"}', alert.freq_once_per_bar)

// --- Visual Chart Elements ---
plot(inTradeWindow or isMiddayWindow ? openHigh : na, color=color.green, style=plot.style_linebr, title="Morning High")
plot(inTradeWindow or isMiddayWindow ? openLow  : na, color=color.red,   style=plot.style_linebr, title="Morning Low")

plot(inTradeWindow ? openHigh + breakoutBuffer : na, color=color.new(color.green, 70), style=plot.style_linebr, title="High Trigger Buffer")
plot(inTradeWindow ? openLow  - breakoutBuffer : na, color=color.new(color.red,   70), style=plot.style_linebr, title="Low Trigger Buffer")

plot(isMiddayWindow or isAfternoonWindow ? middayHigh : na, color=color.new(color.orange, 20), style=plot.style_linebr, title="Midday High")
plot(isMiddayWindow or isAfternoonWindow ? middayLow  : na, color=color.new(color.orange, 20), style=plot.style_linebr, title="Midday Low")
plot(isAfternoonWindow ? middayHigh + breakoutBuffer : na, color=color.new(color.orange, 0),  style=plot.style_linebr, title="Afternoon High Trigger")
plot(isAfternoonWindow ? middayLow  - breakoutBuffer : na, color=color.new(color.orange, 0),  style=plot.style_linebr, title="Afternoon Low Trigger")

plot(emaFast, color=color.new(color.aqua,   60), title="Fast EMA")
plot(emaSlow, color=color.new(color.purple, 60), title="Slow EMA")

plotshape(longCondition  or afternoonLong,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, title="Long Entry")
plotshape(shortCondition or afternoonShort, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="Short Entry")
