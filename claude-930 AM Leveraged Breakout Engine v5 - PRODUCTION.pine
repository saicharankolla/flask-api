//@version=6
indicator("930 AM Leveraged Breakout Engine v7 - PRODUCTION", overlay=true)

// --- Inputs ---
atrPeriod        = input.int(14,    title="ATR Period for Volatility Tracking")
atrMultiplier    = input.float(1.5, title="ATR Trailing Multiplier")
rangeEnd         = input.string("0945", title="Opening Range End (HHMM)", options=["0935", "0945", "1000", "1030"])
volMultiplier    = input.float(1.5, title="Volume Confirmation Multiplier", minval=1.0)
minVolRatio      = input.float(0.5, title="Minimum Volume Ratio to Trade", minval=0.1, maxval=1.5)
cooldownBars     = input.int(15,    title="Re-Entry Cooldown Bars After Signal")
trendEmaFast     = input.int(5,     title="Trend Filter Fast EMA Period")
trendEmaSlow     = input.int(20,    title="Trend Filter Slow EMA Period")

// --- Structural Time Filters (Exchange Timezone) ---
is_session_start = not na(time(timeframe.period, "0930-" + rangeEnd + ":23456", "America/New_York"))
inTradeWindow    = not na(time(timeframe.period, rangeEnd + "-1550:23456", "America/New_York"))
isMarketClose    = not na(time(timeframe.period, "1555-1600:23456", "America/New_York"))
isNewDay         = ta.change(time("D", "America/New_York")) != 0

// --- Persistent Variables ---
var float openHigh      = na
var float openLow       = na
var bool  rangeCaptured = false
var float rangeVolSum   = 0.0
var int   rangeVolBars  = 0
var int   barsSinceEntry = 999
var bool  inPosition     = false
var label rangeVolLabel  = na

if (isNewDay)
    openHigh      := na
    openLow       := na
    rangeCaptured := false
    rangeVolSum   := 0.0
    rangeVolBars  := 0
    barsSinceEntry := 999
    inPosition     := false

if (is_session_start)
    if (not rangeCaptured or na(openHigh))
        openHigh      := high
        openLow       := low
        rangeCaptured := true
    else
        openHigh := math.max(high, openHigh)
        openLow  := math.min(low, openLow)
    rangeVolSum  := rangeVolSum + volume
    rangeVolBars := rangeVolBars + 1

// --- Volatility & Volume Calculations ---
atr          = ta.atr(atrPeriod)
avgRangeVol  = rangeVolBars > 0 ? rangeVolSum / rangeVolBars : na
volThreshold = avgRangeVol * volMultiplier
volRatio     = not na(avgRangeVol) and avgRangeVol > 0 ? volume / volThreshold : 0.0
volConfirmed = volRatio >= 1.0
volSufficient = volRatio >= minVolRatio

// --- Trend Filter (EMA Alignment) ---
emaFast = ta.ema(close, trendEmaFast)
emaSlow = ta.ema(close, trendEmaSlow)
trendBullish = emaFast > emaSlow
trendBearish = emaFast < emaSlow

// --- Cooldown Logic ---
barsSinceEntry := barsSinceEntry + 1
cooldownClear = barsSinceEntry >= cooldownBars

// --- Range Lines ---
plot(inTradeWindow ? openHigh : na, color=color.green, style=plot.style_linebr, linewidth=2, title="Long Breakout Line")
plot(inTradeWindow ? openLow  : na, color=color.red,   style=plot.style_linebr, linewidth=2, title="Short Breakout Line")

// --- Trend EMA Lines ---
plot(emaFast, color=color.new(color.aqua, 60), title="Fast EMA")
plot(emaSlow, color=color.new(color.purple, 60), title="Slow EMA")

// --- Volume Visualization ---
bgcolor(is_session_start ? color.new(color.blue, 88) : na, title="Opening Range Window")
bgcolor(inTradeWindow and volConfirmed ? color.new(color.teal, 90) : na, title="Volume Confirmed Bar")
bgcolor(inTradeWindow and volSufficient and not volConfirmed ? color.new(color.yellow, 92) : na, title="Low Volume Trade Bar")

// Orange X: price broke out but volume below minimum (completely rejected)
priceBreaksHighRejected = ta.crossover(close, openHigh) and inTradeWindow and cooldownClear and not na(openHigh) and not volSufficient
priceBreaksLowRejected  = ta.crossunder(close, openLow)  and inTradeWindow and cooldownClear and not na(openLow)  and not volSufficient
plotshape(priceBreaksHighRejected, title="Volume Rejected Long",  style=shape.xcross, location=location.abovebar, color=color.new(color.orange, 0), size=size.small)
plotshape(priceBreaksLowRejected,  title="Volume Rejected Short", style=shape.xcross, location=location.belowbar, color=color.new(color.orange, 0), size=size.small)

// Red X: volume OK but trend filter blocked it
trendBlockedLong  = ta.crossover(close, openHigh) and inTradeWindow and cooldownClear and not na(openHigh) and volSufficient and not trendBullish
trendBlockedShort = ta.crossunder(close, openLow)  and inTradeWindow and cooldownClear and not na(openLow)  and volSufficient and not trendBearish
plotshape(trendBlockedLong,  title="Trend Blocked Long",  style=shape.xcross, location=location.abovebar, color=color.new(color.red, 40), size=size.small)
plotshape(trendBlockedShort, title="Trend Blocked Short", style=shape.xcross, location=location.belowbar, color=color.new(color.red, 40), size=size.small)

// Label at range close
if (not is_session_start and is_session_start[1] and not na(avgRangeVol))
    label.delete(rangeVolLabel)
    rangeVolLabel := label.new(
        bar_index, openHigh,
        "Avg Vol: "    + str.tostring(math.round(avgRangeVol),  "#,###") +
        "\nThreshold: " + str.tostring(math.round(volThreshold), "#,###") +
        "\nMin Ratio: " + str.tostring(minVolRatio, "#.##") +
        "\nTrend: "     + (trendBullish ? "BULL" : trendBearish ? "BEAR" : "FLAT"),
        color     = color.new(color.blue, 65),
        textcolor = color.white,
        style     = label.style_label_right,
        size      = size.small)

// --- Breakout Conditions (with trend filter) ---
longCondition  = ta.crossover(close, openHigh) and inTradeWindow and cooldownClear and not na(openHigh) and volSufficient and trendBullish
shortCondition = ta.crossunder(close, openLow)  and inTradeWindow and cooldownClear and not na(openLow)  and volSufficient and trendBearish

// Green triangle = full conviction, Yellow diamond = low volume trade
plotshape(longCondition and volConfirmed,      title="Confirmed Long Signal",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0),  size=size.normal)
plotshape(shortCondition and volConfirmed,     title="Confirmed Short Signal", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),    size=size.normal)
plotshape(longCondition and not volConfirmed,  title="Low Vol Long Signal",    style=shape.diamond,      location=location.belowbar, color=color.new(color.yellow, 0), size=size.small)
plotshape(shortCondition and not volConfirmed, title="Low Vol Short Signal",   style=shape.diamond,      location=location.abovebar, color=color.new(color.yellow, 0), size=size.small)

// --- Trade Signals (Entry Only — Alpaca Owns the Trailing Stop Exit) ---
alert_ts = str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

if (longCondition)
    barsSinceEntry := 0
    inPosition     := true
    alert('{"symbol": "' + syminfo.ticker + '", "side": "buy", "price": ' + str.tostring(close) + ', "atr": ' + str.tostring(atr) + ', "vol_ratio": ' + str.tostring(volRatio, "#.##") + ', "alert_time": "' + alert_ts + '"}', alert.freq_once_per_bar)

if (shortCondition)
    barsSinceEntry := 0
    inPosition     := true
    alert('{"symbol": "' + syminfo.ticker + '", "side": "sell", "price": ' + str.tostring(close) + ', "atr": ' + str.tostring(atr) + ', "vol_ratio": ' + str.tostring(volRatio, "#.##") + ', "alert_time": "' + alert_ts + '"}', alert.freq_once_per_bar)

// --- End of Day Safety Liquidation (Always Send — Server Handles Gracefully) ---
if (isMarketClose and inPosition)
    inPosition := false
    alert('{"symbol": "' + syminfo.ticker + '", "side": "exit", "reason": "EOD Liquidation", "alert_time": "' + alert_ts + '"}', alert.freq_once_per_bar)
